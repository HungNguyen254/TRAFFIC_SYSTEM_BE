# ==============================================================================
# Traffic Congestion Prediction Backend - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="Traffic System BE"
ENVIRONMENT="dev"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (JSON array string)
ALLOWED_ORIGINS=["http://127.0.0.1:5500", "http://localhost:5173", "http://localhost:3000"]

# Database Connection
# 1. Local SQLite (Default fallback):
DATABASE_URL="sqlite:///./traffic.db"

# 2. Local Docker PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traffic_db"

# 3. Supabase Cloud PostgreSQL:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Authentication & RBAC Security
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Traffic Assistant (Google Gemini)
# Nhận API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Rate Limiting Configuration (SlowAPI)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT="60/minute"
