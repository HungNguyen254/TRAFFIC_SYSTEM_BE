# Application Configuration
APP_NAME=Traffic System BE
ENVIRONMENT=dev
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Configuration (JSON array string)
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Database Connection
# 1. Local SQLite (Default fallback):
DATABASE_URL="sqlite:///./traffic.db"

# 2. Local Docker PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traffic_db"

# 3. Supabase Cloud PostgreSQL:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Authentication & RBAC Security
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE=1440

# Rate Limiting Configuration (SlowAPI)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT="60/minute"

# Chatbot AI & E2E Security (Google Gemini API & Cryptography)
# Khóa API Google Gemini (lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=""
# Mô hình Gemini sử dụng (mặc định: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
# Khóa Master Server dùng để mã hóa tạm khóa phiên trong RAM (Base64 chuỗi 32-byte).
# Nếu để trống, hệ thống sẽ tự sinh khóa ngẫu nhiên trong bộ nhớ khi khởi động.
CHAT_MASTER_KEY=""

